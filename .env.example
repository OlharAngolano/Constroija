# ============================================================
# Constrói Já — Exemplo de configuração (.env)
# Copie este ficheiro para ".env" e preencha com os seus valores.
# NUNCA commite o .env real: contém credenciais de produção.
# ============================================================

# --- Base de Dados ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=constroija
DB_USER=constroija_app
DB_PASS="trocame_por_uma_password_forte"
# Em produção, o utilizador SQL da aplicação NÃO deve ter
# privilégios ALTER/CREATE/DROP (as migrações são executadas por um operador).

# --- Ambiente ---
APP_URL=https://constroija.com
# Valores: production | development
# (CJ-14) Por omissão assume-se PRODUÇÃO com debug desligado: o debug só deve
# ser ativado explicitamente em ambientes de desenvolvimento controlados.
APP_ENV=production
APP_DEBUG=false

# --- SMTP (mail) ---
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=suporte@constroija.com
SMTP_PASS="trocame"
# ssl | tls | vazio
SMTP_SECURE=ssl
SMTP_FROM_EMAIL=suporte@constroija.com
SMTP_FROM_NAME="Constrói Já"
# Validação TLS do certificado SMTP: manter true em produção.
SMTP_VERIFY_PEER=true

# --- Pagamentos (Webhook) ---
# Preenchido apenas quando existir um gateway real. O simulador foi removido.
# PAYMENTS_WEBHOOK_SECRET=
# PAYMENTS_WEBHOOK_ALGO=sha256
