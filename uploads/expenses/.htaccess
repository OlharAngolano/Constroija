# ============================================================
# uploads/expenses — CONTEÚDO PRIVADO (recibos e fotos de compras)
# Acesso direto por URL é PROIBIDO. Os ficheiros são servidos
# apenas através de /api/files/{id} com autenticação e autorização
# por projeto (auditoria CJ-07).
# ============================================================
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
